{
  "name": "mnemoweave-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test tests/unit/*.test.ts tests/contract/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.ts",
    "start": "node apps/server/src/main.ts",
    "start:mcp": "node apps/server/src/mcp-main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "0.25.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
