{
  "mcpServers": {
    "mnemoweave": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/dist/apps/server/src/mcp-main.js"],
      "env": {
        "MNEMON_BINARY": "${MNEMON_BINARY}",
        "MNEMON_DATA_DIR": "${MNEMON_DATA_DIR}",
        "MNEMON_STORE": "${MNEMON_STORE}",
        "MNEMOWEAVE_STATE_DIR": "${MNEMOWEAVE_STATE_DIR}"
      },
      "enabled": true,
      "timeoutMs": 60000
    }
  }
}
