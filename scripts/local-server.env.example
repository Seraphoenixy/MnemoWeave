# Copy to .env.local-server. The scheduled task loads this file at start.
#
# This file holds NO credentials. MNEMOWEAVE_TOKEN and MNEMOWEAVE_OPERATOR_TOKEN live in the
# signed-in user's environment, which is the single source every consumer reads (the Server,
# its launcher, and all three host plugins). install-local-server-task.ps1 generates them on
# first registration and stores them there.
#
# To inspect or rotate them:
#   [Environment]::GetEnvironmentVariable('MNEMOWEAVE_TOKEN','User')
#   [Environment]::SetEnvironmentVariable('MNEMOWEAVE_TOKEN','<new 24+ char value>','User')
# After changing either one, re-run the task (or sign out and back in) so the Server picks it up.

# Path to the Mnemon 0.2.13 executable, or a bare command name resolved through PATH.
MNEMON_BINARY=mnemon
# Use a dedicated store, not the default user memory directory.
MNEMON_DATA_DIR=work/local-server/mnemon
MNEMON_STORE=local

# Governance database, blobs and snapshots. Must be absolute or relative to the repo root.
MNEMOWEAVE_STATE_DIR=work/local-server/state

MNEMOWEAVE_PORT=4317
MNEMOWEAVE_WORKER=on
